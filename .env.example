APP_NAME="BATIX Growth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://growth.example.com
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Domaine routé par Traefik sur le VPS, sans https://
BATIX_AGENT_HOST=growth.example.com

ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# PostgreSQL est installé directement sur le VPS.
# Depuis Docker, host.docker.internal est mappé vers la passerelle de l'hôte Linux.
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=batix_agent
DB_USERNAME=batix_agent
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=disable

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

OPENAI_API_KEY=
OPENAI_MARKETING_MODEL=gpt-5-mini

# Phase Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Optional future BatixPro API integration
BATIXPRO_API_URL=
BATIXPRO_API_TOKEN=
