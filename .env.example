APP_NAME="BATIX Growth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://growth.example.com
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Domaine routé par Traefik sur le VPS, sans https://
BATIX_AGENT_HOST=growth.example.com

# Créez le premier compte après migration avec :
# php artisan growth:admin admin --name="Administrateur"

# PostgreSQL est installé directement sur le VPS.
# Depuis Docker, host.docker.internal est mappé vers la passerelle de l'hôte Linux.
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=batix_agent
DB_USERNAME=batix_agent
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=disable

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Phase Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# URL à déclarer comme URI de redirection OAuth dans l'application Meta.
# Laissez vide pour utiliser automatiquement APP_URL/facebook/callback.
META_REDIRECT_URI=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Optional future BatixPro API integration
BATIXPRO_API_URL=
BATIXPRO_API_TOKEN=
